# ── AI Wellness Platform — Production Environment ──
# Copy to .env.production and fill in all values.
#
#   cp .env.production.example .env.production
#
# WARNING: This file contains secrets. Never commit it to git.

# ── JWT Authentication (REQUIRED — CHANGE THIS) ──
# Generate a strong random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────
CORS_ORIGINS=https://wellness.thomasyeung.dev,https://api.wellness.thomasyeung.dev

# ── Debug ───────────────────────────────────────────
DEBUG=false

# ── AI Provider ─────────────────────────────────────
DEEPSEEK_API_KEY=

# ── Database ────────────────────────────────────────
DATABASE_URL=sqlite:///./data/ai_wellness.db

# ── Frontend ────────────────────────────────────────
API_BASE_URL=https://api.wellness.thomasyeung.dev
