# ── AI Provider ─────────────────────────────────────
# DeepSeek API Key (optional — without this, local fallback reports are used)
DEEPSEEK_API_KEY=

# ── JWT Authentication (⚠️ CRITICAL FOR PRODUCTION) ──
# WARNING: Generate a strong random string for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For production, set to your frontend domain only.
# Example: CORS_ORIGINS=https://myapp.com,https://www.myapp.com
# Default: http://localhost:8501,http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://localhost:8000

# ── Debug ───────────────────────────────────────────
# Set to false in production to hide detailed error messages.
DEBUG=false

# Note: DATABASE_URL and API_BASE_URL are set in docker-compose.yml
# Do not override them here unless you need to customize behavior.
