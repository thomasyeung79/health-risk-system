# DeepSeek API Key (optional — without this, local fallback reports are used)
DEEPSEEK_API_KEY=

# JWT Secret (change this in production)
JWT_SECRET=docker-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Note: DATABASE_URL and API_BASE_URL are set in docker-compose.yml
# Do not override them here unless you need to customize behavior.
