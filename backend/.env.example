# Database
DATABASE_URL=sqlite:///./data/ai_wellness.db

# Application
APP_NAME=AI Wellness Platform
DEBUG=true
LANGUAGE=en

# DeepSeek API Key (optional — without this, local fallback reports are used)
DEEPSEEK_API_KEY=

# JWT Authentication (⚠️ REQUIRED)
# Generate a strong random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated or JSON array
CORS_ORIGINS=http://localhost:8501,http://localhost:8000
